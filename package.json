{
  "name": "proofpact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "verify:database": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-database.ts",
    "verify:pact-store": "node --conditions=react-server --env-file=.env.local --import tsx scripts/verify-pact-store.ts",
    "migrate:settlement": "node --env-file=.env.local --import tsx scripts/apply-settlement-migration.ts",
    "migrate:changes": "node --env-file=.env.local --import tsx scripts/apply-change-request-migration.ts",
    "migrate:funding": "node --env-file=.env.local --import tsx scripts/apply-funding-migration.ts",
    "reconcile:funding": "node --conditions=react-server --env-file=.env.local --import tsx scripts/reconcile-pact-funding.ts",
    "preflight:escrow": "node --env-file=.env.local --import tsx scripts/preflight-escrow-deployment.ts",
    "deploy:escrow": "node --env-file=.env.local --import tsx scripts/deploy-escrow.ts",
    "verify:escrow": "node --env-file=.env.local --import tsx scripts/verify-escrow-deployment.ts",
    "verify:live-fraud": "node --conditions=react-server --env-file=.env.local --import tsx scripts/live-fraud-verification.ts",
    "verify:live-fraud:execute": "node --conditions=react-server --env-file=.env.local --import tsx scripts/live-fraud-verification.ts --execute",
    "preflight:secure-delivery": "node --conditions=react-server --env-file=.env.local --import tsx scripts/preflight-secure-delivery.ts",
    "verify:secure-delivery:execute": "node --conditions=react-server --env-file=.env.local --import tsx scripts/execute-secure-delivery-service.ts",
    "compose:secure-delivery": "node --conditions=react-server --env-file=.env.local --import tsx scripts/compose-fresh-secure-delivery.ts",
    "audit:latest-verification": "node --env-file=.env.local --import tsx scripts/audit-latest-verification-run.ts",
    "recover:stalled-verification": "node --conditions=react-server --env-file=.env.local --import tsx scripts/recover-stalled-verification.ts",
    "audit:payer-usdc": "node --env-file=.env.local --import tsx scripts/audit-payer-usdc.ts",
    "mcp": "node --conditions=react-server --env-file=.env.local --import tsx mcp/server.ts",
    "verify:mcp": "node --env-file=.env.local --import tsx scripts/smoke-mcp.ts",
    "fmt:contracts": "forge fmt --check --root contracts",
    "build:contracts": "forge build --root contracts --offline",
    "test:contracts": "forge test --root contracts --offline",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run fmt:contracts && npm run build:contracts && npm run test:contracts && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.102.8",
    "@x402/evm": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "@x402/svm": "^2.25.0",
    "next": "^16.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "undici": "^7.29.1",
    "viem": "^2.55.19",
    "wagmi": "^2.19.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
